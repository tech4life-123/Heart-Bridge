# HeartBridge environment variables
# Copy to .env.local and fill in. NEVER commit .env.local or real secrets.

# --- Public (safe for the browser) ---
# From Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
# The anon / publishable key. Safe to expose ONLY because Row Level Security is enabled on every table.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Canonical site URL, used for email confirmation / password reset links.
# Local: http://localhost:3000   Production: https://your-domain
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server only (never prefix with NEXT_PUBLIC_) ---
# Not used in Phase 1. Needed later for admin tooling and payment webhooks.
# SUPABASE_SERVICE_ROLE_KEY=

# --- Optional AI (Phase 9). Leave unset to keep every AI feature off. ---
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-haiku-4-5-20251001
# Staff-only advisory summaries of reported conversations (also needs the key):
# AI_SAFETY_ENABLED=true

# Optional public support address shown on the Privacy and Terms pages (only set if you really monitor it).
# NEXT_PUBLIC_SUPPORT_EMAIL=
